{
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 60s
		}
	}
}

{$BETTERGIT_DOMAIN} {
	request_body {
		max_size 25MiB
	}
	@controlPlane path /v1 /v1/* /webhooks/github
	handle @controlPlane {
		reverse_proxy control-plane:3000
	}
	handle {
		root * /srv/bettergit
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
		}
		file_server
	}
}
